rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.email == 'jaronwalker@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Validation Blueprints

    function isValidProposal(data) {
      return data.keys().hasAll(['title', 'description', 'status', 'endsAt', 'yesVotes', 'totalVotes'])
        && data.keys().size() == 6
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 1000
        && data.status in ['Active', 'Passed', 'Failed']
        && data.endsAt is string 
        && data.yesVotes is int && data.yesVotes >= 0
        && data.totalVotes is int && data.totalVotes >= data.yesVotes;
    }

    function isValidMeme(data) {
      return data.keys().hasAll(['imageUrl', 'author', 'tips', 'createdAt'])
        && data.keys().size() == 4
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 500
        && data.author is string && data.author.size() > 0 && data.author.size() <= 50
        && data.tips is number && data.tips >= 0
        && (data.createdAt == request.time || data.createdAt is timestamp); 
    }

    function isValidStat(data) {
      return data.keys().hasAll(['price', 'marketCap', 'liquidity', 'holders', 'volume24h', 'burnedToken', 'burnPercent', 'tax', 'lpStatus'])
        && data.keys().size() == 9
        && data.price is number
        && data.marketCap is number
        && data.liquidity is number
        && data.holders is int
        && data.volume24h is number
        && data.burnedToken is number
        && data.burnPercent is number
        && data.tax is string && data.tax.size() <= 10
        && data.lpStatus is string && data.lpStatus.size() <= 20;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['key', 'value', 'updatedAt'])
        && data.keys().size() == 3
        && data.key is string && data.key.size() > 0
        && data.value is string
        && (data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    function isValidPing(data) {
      return data.keys().hasAll(['lat', 'lng', 'color', 'createdAt'])
        && data.keys().size() == 4
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.color is string && data.color.size() <= 20
        && (data.createdAt == request.time || data.createdAt is timestamp);
    }

    function isValidCityVisit(data) {
      return data.keys().hasAll(['city', 'country', 'lat', 'lng', 'createdAt'])
        && data.keys().size() == 5
        && data.city is string && data.city.size() > 0 && data.city.size() <= 100
        && data.country is string && data.country.size() > 0 && data.country.size() <= 100
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // Phase 4: Match Blocks

    match /proposals/{proposalId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidProposal(incoming());
      allow update: if (
        isSignedIn() && isValidProposal(incoming()) && (
          isAdmin() ||
          // Action: Vote
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['yesVotes', 'totalVotes']) &&
            incoming().totalVotes == existing().totalVotes + 1 &&
            (incoming().yesVotes == existing().yesVotes || incoming().yesVotes == existing().yesVotes + 1) &&
            existing().status == 'Active'
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /memes/{memeId} {
      allow get, list: if true;
      allow create: if isEmailVerified() && isValidMeme(incoming());
      allow update: if isAdmin() && isValidMeme(incoming());
      allow delete: if isAdmin();
    }

    match /stats/{statId} {
      allow get, list: if true;
      allow write: if isAdmin() && isValidStat(incoming());
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin() && isValidSetting(incoming());
    }

    match /pings/{pingId} {
      allow read: if true;
      allow create: if isValidPing(incoming());
    }

    match /city_visits/{visitId} {
      allow read: if true;
      allow create: if isValidCityVisit(incoming());
    }
  }
}
